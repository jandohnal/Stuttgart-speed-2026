text = "A TRIBUTE"

[node name="Tribute" type="Label" parent="CreditsDialog/Content"]
custom_minimum_size = Vector2(820, 0)
layout_mode = 2
theme_type_variation = &"CreditsText"
text = "Stuttgart Speed is a love letter to Need for Speed: Porsche 2000 (Porsche Unleashed), the racer EA Canada released in 2000 that took you through fifty years of one Stuttgart car maker, from the first 356 to the 911 Turbo.

It is made for those who remember it: to drive the original cars, tracks and sounds again on today's machines, in Full HD with modern light and physics and a few new ideas of its own. Not a remake, rather the same story told a little differently."
autowrap_mode = 3

[node name="MadeHeader" type="Label" parent="CreditsDialog/Content"]
layout_mode = 2
theme_type_variation = &"PanelHeader"
text = "VIBE-CODED"

[node name="Made" type="Label" parent="CreditsDialog/Content"]
custom_minimum_size = Vector2(820, 0)
layout_mode = 2
theme_type_variation = &"CreditsText"
text = "Made by Honza Dohnal together with Claude Opus 5.5 (Anthropic) in Claude Code: decoding the original data formats, the conversion tools, the driving physics, the opponents and this menu."
autowrap_mode = 3

[node name="StatsHeader" type="Label" parent="CreditsDialog/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PanelHeader"
text = "BY THE NUMBERS"

